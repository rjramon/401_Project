# Copy this file to ".env" and fill in real values. Do NOT commit ".env".
# These are variable NAMES with placeholder values only — no real secrets.

# Development database connection string (local MySQL now; AWS RDS later with
# no code change — only this value differs).
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sts

# SEPARATE test database connection string. Tests use this and never touch
# the development database.
TEST_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sts_test

# Flask secret key. Use a long random value in a real environment.
SECRET_KEY=change-me-to-a-random-secret
